* {
    -unity-font: resource("GameFont");
    -unity-font-definition: resource("GameFont");
}

.screen-root {
    position: absolute;
    bottom: 36px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: flex-end;
}

.tray {
    flex-direction: column;
    align-items: center;
    background-color: rgba(8, 12, 22, 0.94);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
    padding-top: 14px;
    padding-bottom: 22px;
    padding-left: 28px;
    padding-right: 28px;
    border-left-width: 3.5px;
    border-right-width: 3.5px;
    border-top-width: 3.5px;
    border-bottom-width: 3.5px;
    border-left-color: rgb(0, 235, 255);
    border-right-color: rgb(0, 235, 255);
    border-top-color: rgb(0, 235, 255);
    border-bottom-color: rgb(0, 235, 255);
}

.header-label {
    color: rgb(0, 235, 255);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(0, 235, 255, 0.5);
    -unity-text-outline-width: 1px;
}

.balls-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 950px;
}

.ball-item {
    width: 96px;
    height: 96px;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 6px;
    margin-bottom: 6px;
    justify-content: center;
    align-items: center;
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    border-bottom-left-radius: 48px;
    border-bottom-right-radius: 48px;
    border-left-width: 3.5px;
    border-right-width: 3.5px;
    border-top-width: 3.5px;
    border-bottom-width: 3.5px;
    border-left-color: rgba(255, 255, 255, 0.75);
    border-right-color: rgba(255, 255, 255, 0.75);
    border-top-color: rgba(255, 255, 255, 0.75);
    border-bottom-color: rgba(255, 255, 255, 0.75);
    transition-property: scale, border-left-color, border-right-color, border-top-color, border-bottom-color, border-left-width, border-right-width, border-top-width, border-bottom-width;
    transition-duration: 0.15s;
}

.ball-item:hover {
    scale: 1.08 1.08;
    border-left-color: rgb(0, 255, 255);
    border-right-color: rgb(0, 255, 255);
    border-top-color: rgb(0, 255, 255);
    border-bottom-color: rgb(0, 255, 255);
    border-left-width: 4.5px;
    border-right-width: 4.5px;
    border-top-width: 4.5px;
    border-bottom-width: 4.5px;
}

.ball-item--selected {
    scale: 1.16 1.16;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgb(255, 225, 40);
    border-right-color: rgb(255, 225, 40);
    border-top-color: rgb(255, 225, 40);
    border-bottom-color: rgb(255, 225, 40);
}

.ball-number {
    color: rgb(255, 255, 255);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
    -unity-text-outline-width: 2.5px;
}
